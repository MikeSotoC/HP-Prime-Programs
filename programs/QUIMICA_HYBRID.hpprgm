// QUIMICA HYBRID 1.0 - HP Prime G1/G2
// Interfaz: HP PPL | Motor: MicroPython
// Instalar con HP Connectivity Kit y ejecutar QUIMICA_HYBRID().

QOP:=0;
QA:=0;
QB:=0;
QC:=0;
QD:=0;
QOUT1:=0;
QOUT2:=0;
QOUT3:=0;
QTEXT:="";
QERR:=0;

#PYTHON CHEM_ENGINE
import math
import hpprime as hp

H=6.62607015e-34
C=299792458.0
EV=1.602176634e-19
NA=6.02214076e23
R=0.082057366
SYMBOLS=('H He Li Be B C N O F Ne Na Mg Al Si P S Cl Ar K Ca Sc Ti V Cr Mn Fe Co Ni Cu Zn Ga Ge As Se Br Kr '
         'Rb Sr Y Zr Nb Mo Tc Ru Rh Pd Ag Cd In Sn Sb Te I Xe Cs Ba La Ce Pr Nd Pm Sm Eu Gd Tb Dy Ho Er Tm Yb Lu '
         'Hf Ta W Re Os Ir Pt Au Hg Tl Pb Bi Po At Rn Fr Ra Ac Th Pa U Np Pu Am Cm Bk Cf Es Fm Md No Lr '
         'Rf Db Sg Bh Hs Mt Ds Rg Cn Nh Fl Mc Lv Ts Og').split()

def gv(name):
    return hp.eval(name)

def sv(name,value):
    # El parser HOME de algunos firmwares falla con exponentes e+NN.
    num=repr(float(value)).replace('e+','e')
    hp.eval(name+':='+num)

def st(text):
    # Construye los saltos con CHAR(10), compatible con PPL.
    parts=str(text).split('\n')
    quoted=[]
    for part in parts:
        part=part.replace('\\','\\\\').replace('"','\\"')
        quoted.append('"'+part+'"')
    hp.eval('QTEXT:='+'+CHAR(10)+'.join(quoted))

def ok(a=0,b=0,c=0,text=''):
    hp.eval('QERR:=0')
    sv('QOUT1',a); sv('QOUT2',b); sv('QOUT3',c)
    st(text)

def fail(text):
    hp.eval('QERR:=1')
    st(text)

def sci(x):
    if x==0: return '0'
    return '{:.6g}'.format(x)

def planck(op,x):
    if x<=0: raise ValueError('El dato debe ser mayor que cero.')
    if op==101: lam=x*1e-9
    elif op==102: lam=C/x
    else: lam=H*C/x
    f=C/lam; e=H*f
    return f,lam,e

def bohr(op,n1,n2):
    if n1<1 or int(n1)!=n1: raise ValueError('n debe ser entero positivo.')
    n1=int(n1)
    if op==201:
        return 0.529*n1*n1,2.18769126364e8/n1,-13.605693122994/(n1*n1)
    if n2<1 or int(n2)!=n2 or n1==n2:
        raise ValueError('Use dos niveles enteros positivos y distintos.')
    n2=int(n2)
    de=13.605693122994*(1/(n1*n1)-1/(n2*n2))
    ej=abs(de)*EV
    return de,ej,H*C/ej

def einstein(op,x):
    if x<0: raise ValueError('El dato no puede ser negativo.')
    if op==301:
        kg=x; e=kg*C*C
    elif op==302:
        kg=x/1000.0; e=kg*C*C
    else:
        e=x; kg=e/(C*C)
    return kg,e,e/EV

def atom(z,a,charge):
    if z<1 or a<z or int(z)!=z or int(a)!=a or int(charge)!=charge:
        raise ValueError('Compruebe Z, A y la carga entera.')
    p=int(z); n=int(a-z); e=int(z-charge)
    if e<0: raise ValueError('La carga produce electrones negativos.')
    return p,n,e

def electron_config(z):
    if z<1 or z>118 or int(z)!=z:
        raise ValueError('Z debe ser entero entre 1 y 118.')
    order=((1,'s',2),(2,'s',2),(2,'p',6),(3,'s',2),(3,'p',6),(4,'s',2),
           (3,'d',10),(4,'p',6),(5,'s',2),(4,'d',10),(5,'p',6),(6,'s',2),
           (4,'f',14),(5,'d',10),(6,'p',6),(7,'s',2),(5,'f',14),(6,'d',10),(7,'p',6))
    left=int(z); filled=[]
    for n,l,cap in order:
        if left<=0: break
        e=min(left,cap); filled.append([n,l,e]); left-=e
    # Excepciones de estabilidad mas usadas en cursos introductorios.
    shifts={24:(3,'d',4,'s'),29:(3,'d',4,'s'),41:(4,'d',5,'s'),42:(4,'d',5,'s'),
            44:(4,'d',5,'s'),45:(4,'d',5,'s'),46:(4,'d',5,'s'),47:(4,'d',5,'s'),
            78:(5,'d',6,'s'),79:(5,'d',6,'s')}
    if z in shifts:
        dn,dl,sn,sl=shifts[z]
        di=next((i for i,x in enumerate(filled) if x[0]==dn and x[1]==dl),None)
        si=next((i for i,x in enumerate(filled) if x[0]==sn and x[1]==sl),None)
        if di is not None and si is not None and filled[si][2]>0:
            filled[di][2]+=1; filled[si][2]-=1
    cfg=' '.join(str(n)+l+str(e) for n,l,e in filled if e)
    period=max(x[0] for x in filled if x[2])
    return SYMBOLS[int(z)-1],cfg,period

def mole(op,a,b):
    if a<=0: raise ValueError('El valor debe ser mayor que cero.')
    if op==501:
        if b<=0: raise ValueError('La masa molar debe ser positiva.')
        mol=a/b
    elif op==502: mol=a/NA
    else: mol=a
    return mol,mol*NA,mol*b if b>0 else 0

def gas(op,p,v,n,t):
    vals=[p,v,n,t]
    if sum(1 for x in vals if x<0)!=1:
        raise ValueError('Deje exactamente una incognita en -1.')
    if op!=601: raise ValueError('Operacion desconocida.')
    if p<0: p=n*R*t/v
    elif v<0: v=n*R*t/p
    elif n<0: n=p*v/(R*t)
    else: t=p*v/(n*R)
    if min(p,v,n,t)<=0: raise ValueError('Los datos conocidos deben ser positivos.')
    return p,v,n,t

def solution(op,a,b,c):
    if op==701:
        if a<0 or b<=0: raise ValueError('Compruebe moles y volumen.')
        return a/b,0,0
    if op==702:
        if min(a,b,c)<=0: raise ValueError('M1, V1 y M2 deben ser positivos.')
        return a*b/c,0,0
    if op==703:
        if min(a,b,c)<=0: raise ValueError('Masa, masa molar y volumen deben ser positivos.')
        return (a/b)/c,0,0

def acid(op,x):
    if x<=0: raise ValueError('La concentracion debe ser positiva.')
    if op==801: h=x
    elif op==802: h=10**(-x)
    elif op==803: h=1e-14/x
    else: h=10**(-(14-x))
    ph=-math.log10(h); poh=14-ph; oh=1e-14/h
    return ph,poh,h,oh

def neutral(a,b,c):
    if min(a,b,c)<=0: raise ValueError('Todos los datos deben ser positivos.')
    return a*b/c

try:
    op=int(gv('QOP')); a=float(gv('QA')); b=float(gv('QB'))
    c=float(gv('QC')); d=float(gv('QD'))
    if 101<=op<=103:
        f,l,e=planck(op,a)
        ok(f,l,e,'f = '+sci(f)+' Hz\nlambda = '+sci(l)+' m\nE = '+sci(e)+' J\nE = '+sci(e/EV)+' eV')
    elif 201<=op<=202:
        x,y,z=bohr(op,a,b)
        if op==201: ok(x,y,z,'Radio = '+sci(x)+' A\nVelocidad = '+sci(y)+' cm/s\nEnergia = '+sci(z)+' eV')
        else: ok(x,y,z,'Delta E = '+sci(x)+' eV\n|E| = '+sci(y)+' J\nlambda = '+sci(z)+' m')
    elif 301<=op<=303:
        kg,e,ev=einstein(op,a); ok(kg,e,ev,'m = '+sci(kg)+' kg\nE = '+sci(e)+' J\nE = '+sci(ev)+' eV')
    elif op==401:
        p,n,e=atom(a,b,c); ok(p,n,e,'Protones = '+str(p)+'\nNeutrones = '+str(n)+'\nElectrones = '+str(e))
    elif op==402:
        sym,cfg,period=electron_config(a); ok(a,period,0,sym+'  Z='+str(int(a))+'\nConfiguracion:\n'+cfg+'\nPeriodo = '+str(period))
    elif 501<=op<=503:
        mol,part,mass=mole(op,a,b); ok(mol,part,mass,'Moles = '+sci(mol)+' mol\nParticulas = '+sci(part)+'\nMasa = '+sci(mass)+' g')
    elif op==601:
        p,v,n,t=gas(op,a,b,c,d); ok(p,v,n,'P = '+sci(p)+' atm\nV = '+sci(v)+' L\nn = '+sci(n)+' mol\nT = '+sci(t)+' K')
    elif 701<=op<=703:
        x,_,_=solution(op,a,b,c); ok(x,0,0,('V2 = ' if op==702 else 'M = ')+sci(x)+(' L' if op==702 else ' mol/L'))
    elif 801<=op<=804:
        ph,poh,h,oh=acid(op,a); ok(ph,poh,h,'pH = '+sci(ph)+'\npOH = '+sci(poh)+'\n[H+] = '+sci(h)+' M\n[OH-] = '+sci(oh)+' M')
    elif op==901:
        v=neutral(a,b,c); ok(v,0,0,'Volumen requerido = '+sci(v)+' L')
    else: fail('Operacion del motor no reconocida.')
except Exception as ex:
    fail('Error: '+str(ex))
#END

EXPORT QUIMICA_HYBRID()
BEGIN
 LOCAL u:=1;
 REPEAT
  CHOOSE(u,"QUIMICA HYBRID","ESTRUCTURA ATOMICA","MOL Y ESTEQUIOMETRIA","GASES Y SOLUCIONES","ACIDOS Y BASES","FORMULARIO");
  IF u==1 THEN QH_ATOMICA(); END;
  IF u==2 THEN QH_MOL(); END;
  IF u==3 THEN QH_GASES(); END;
  IF u==4 THEN QH_ACIDOS(); END;
  IF u==5 THEN QH_FORMULARIO(); END;
 UNTIL u==0;
END;

QH_RUN(op,a,b,c,d,titulo)
BEGIN
 QOP:=op; QA:=a; QB:=b; QC:=c; QD:=d; QERR:=0; QTEXT:="";
 PYTHON(CHEM_ENGINE);
 IF QERR THEN MSGBOX(QTEXT); ELSE QH_RESULT(titulo,QTEXT); END;
END;

QH_RESULT(titulo,texto)
BEGIN
 LOCAL resto:=texto;
 LOCAL linea:="";
 LOCAL pos:=0;
 LOCAL y:=55;
 RECT_P(#E8EEF2);
 RECT_P(0,0,319,39,#183B56,#183B56);
 RECT_P(0,40,319,43,#2B7A78,#2B7A78);
 TEXTOUT_P(titulo,10,9,2,#FFFFFF);
 REPEAT
  pos:=INSTRING(resto,CHAR(10));
  IF pos==0 THEN
   linea:=resto; resto:="";
  ELSE
   IF pos==1 THEN linea:=""; ELSE linea:=LEFT(resto,pos-1); END;
   resto:=MID(resto,pos+1);
  END;
  TEXTOUT_P(linea,12,y,1,#102A43,296,#E8EEF2);
  y:=y+19;
 UNTIL SIZE(resto)==0 OR y>202;
 RECT_P(0,216,319,239,#183B56,#183B56);
 TEXTOUT_P("ENTER / ESC PARA VOLVER",65,222,1,#FFFFFF);
 FREEZE;
END;

QH_ATOMICA()
BEGIN
 LOCAL o:=1,a:=-1,b:=-1,c:=0;
 REPEAT
  CHOOSE(o,"ESTRUCTURA ATOMICA","PLANCK: lambda (nm)","PLANCK: frecuencia (Hz)","PLANCK: energia (J)","BOHR: estado n","BOHR: transicion","EINSTEIN: masa (kg)","EINSTEIN: masa (g)","EINSTEIN: energia (J)","ATOMO / ION","CONFIGURACION ELECTRONICA");
  IF o>=1 AND o<=3 THEN
   a:=1; IF INPUT(a,"PLANCK","Dato conocido") THEN QH_RUN(100+o,a,0,0,0,"PLANCK"); END;
  END;
  IF o==4 THEN a:=1; IF INPUT(a,"MODELO DE BOHR","Nivel n") THEN QH_RUN(201,a,0,0,0,"BOHR"); END; END;
  IF o==5 THEN a:=1;b:=2; IF INPUT({a,b},"TRANSICION",{"n inicial","n final"}) THEN QH_RUN(202,a,b,0,0,"TRANSICION"); END; END;
  IF o>=6 AND o<=8 THEN a:=1; IF INPUT(a,"E=mc2","Dato conocido") THEN QH_RUN(295+o,a,0,0,0,"EINSTEIN"); END; END;
  IF o==9 THEN a:=17;b:=35;c:=-1; IF INPUT({a,b,c},"ATOMO / ION",{"Z","A","Carga"}) THEN QH_RUN(401,a,b,c,0,"ATOMO / ION"); END; END;
  IF o==10 THEN a:=17; IF INPUT(a,"CONFIGURACION","Numero atomico Z") THEN QH_RUN(402,a,0,0,0,"CONFIGURACION"); END; END;
 UNTIL o==0;
END;

QH_MOL()
BEGIN
 LOCAL o:=1,a:=18,b:=18.015;
 REPEAT
  CHOOSE(o,"MOL Y PARTICULAS","MASA A MOLES","PARTICULAS A MOLES","MOLES A PARTICULAS");
  IF o==1 THEN IF INPUT({a,b},"MASA A MOLES",{"Masa (g)","Masa molar (g/mol)"}) THEN QH_RUN(501,a,b,0,0,"MOLES"); END; END;
  IF o==2 THEN a:=6.02214076E23; IF INPUT(a,"PARTICULAS","Cantidad") THEN QH_RUN(502,a,0,0,0,"MOLES"); END; END;
  IF o==3 THEN a:=1;b:=18.015; IF INPUT({a,b},"MOLES",{"Moles","Masa molar (opcional)"}) THEN QH_RUN(503,a,b,0,0,"PARTICULAS"); END; END;
 UNTIL o==0;
END;

QH_GASES()
BEGIN
 LOCAL o:=1,p:=1,v:=-1,n:=1,t:=273.15,a:=1,b:=1,c:=1;
 REPEAT
  CHOOSE(o,"GASES Y SOLUCIONES","GAS IDEAL PV=nRT","MOLARIDAD n/V","DILUCION M1V1=M2V2","MOLARIDAD DESDE MASA");
  IF o==1 THEN IF INPUT({p,v,n,t},"GAS IDEAL",{"P atm (-1?)","V L (-1?)","n mol (-1?)","T K (-1?)"}) THEN QH_RUN(601,p,v,n,t,"GAS IDEAL"); END; END;
  IF o==2 THEN a:=1;b:=1; IF INPUT({a,b},"MOLARIDAD",{"Moles","Volumen (L)"}) THEN QH_RUN(701,a,b,0,0,"MOLARIDAD"); END; END;
  IF o==3 THEN a:=1;b:=0.1;c:=0.2; IF INPUT({a,b,c},"DILUCION",{"M1","V1 (L)","M2"}) THEN QH_RUN(702,a,b,c,0,"DILUCION"); END; END;
  IF o==4 THEN a:=10;b:=58.44;c:=1; IF INPUT({a,b,c},"MOLARIDAD",{"Masa (g)","Masa molar","Volumen (L)"}) THEN QH_RUN(703,a,b,c,0,"MOLARIDAD"); END; END;
 UNTIL o==0;
END;

QH_ACIDOS()
BEGIN
 LOCAL o:=1,a:=0.01,b:=0.1,c:=0.1;
 REPEAT
  CHOOSE(o,"ACIDOS Y BASES","DESDE [H+]","DESDE pH","DESDE [OH-]","DESDE pOH","NEUTRALIZACION MaVa=MbVb");
  IF o>=1 AND o<=4 THEN IF INPUT(a,"ACIDOS Y BASES","Dato conocido") THEN QH_RUN(800+o,a,0,0,0,"ACIDOS Y BASES"); END; END;
  IF o==5 THEN a:=0.1;b:=0.025;c:=0.2; IF INPUT({a,b,c},"NEUTRALIZACION",{"Ma","Va (L)","Mb"}) THEN QH_RUN(901,a,b,c,0,"NEUTRALIZACION"); END; END;
 UNTIL o==0;
END;

QH_FORMULARIO()
BEGIN
 QH_RESULT("FORMULARIO","E = h f = h c / lambda\nBohr: En = -13.6/n^2 eV\nE = m c^2\nn = m/MM = N/NA\nPV = nRT\nM = n/V\nM1 V1 = M2 V2\npH = -log[H+]\npH + pOH = 14\n[H+][OH-] = 1E-14");
END;

START()
BEGIN
 QUIMICA_HYBRID();
END;
